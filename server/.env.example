# Copy to server/.env. Never commit the real file.
# Values below are safe local defaults. Replace every secret before production.

NODE_ENV=development
PORT=4108
# Local MongoDB must be a replica set (checkout uses a transaction).
MONGODB_URI=mongodb://127.0.0.1:27017/farmcity?replicaSet=rs0
CLIENT_ORIGIN=http://127.0.0.1:4178,http://localhost:4178
SERVER_URL=http://127.0.0.1:4108

# Required in production. Any long random strings.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# lax for local and same-site deploys. none + COOKIE_SECURE=true when the
# shop and API are on different sites (Vercel + Render).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
BCRYPT_COST=12

# Cloudinary — all three required or uploads stay on local disk (server/uploads).
# Leave blank for local development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# bKash tokenized checkout. Sandbox by default.
# The method stays hidden until these are set AND an admin enables bKash.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized

# Nagad checkout. Paste PEM keys with \n for newlines.
# Hidden until configured AND enabled in admin settings.
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

# SSLCommerz. Sandbox unless SSLCOMMERZ_LIVE=true.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
